# =============================================================
# 激活码管理系统 - 通用环境配置模板
# 复制为 .env 后使用；Docker 部署请参考 .env.docker.example
# 所有变量均为可选（有合理默认值），按需填写
# =============================================================

# ---- 运行环境 ----
# 生产环境必须为 production（会启用生产安全策略与校验）
NODE_ENV=production
# 服务端口（默认 3000）
PORT=3000

# ---- 数据库 ----
# SQLite 文件路径（相对 prisma/ 目录）
DATABASE_URL=file:./dev.db

# ---- 安全 ----
# JWT 密钥：生产环境必填，建议 32 位以上随机字符串
# 未设置时生产环境会拒绝启动（README 有生成方式）
JWT_SECRET=please-change-me-to-a-long-random-secret

# 后台访问 IP 白名单（逗号分隔，支持 CIDR）
# 默认仅允许本机
ALLOWED_IPS=127.0.0.1,::1

# 管理员初始密码：仅首次初始化（数据库无管理员）时使用
# 已初始化的库可不设置；生产环境强烈建议设置
ADMIN_INITIAL_PASSWORD=

# auth-token cookie 的 Secure 标志
# - 有 HTTPS 反代：留空（自动识别 x-forwarded-proto）或设 true
# - 纯 HTTP 内网部署：设 false（否则浏览器拒收 cookie 导致登录死循环）
COOKIE_SECURE=false

# ---- License API ----
# 响应签名密钥：配置后 License API 响应带 HMAC 签名，SDK 验签防篡改
# 留空不签名（向后兼容）
LICENSE_RESPONSE_SECRET=

# License API 限流（每 IP 每分钟窗口）
LICENSE_API_RATE_LIMIT_MAX=120
LICENSE_API_RATE_LIMIT_WINDOW_MS=60000

# ---- 购买中心 ----
# 购买中心总开关（后台系统配置也可以改；环境变量优先级更高时以此为准）
# SHOP_ENABLED=true

# 公开 Shop API 限流（每 IP 每分钟窗口）
SHOP_API_RATE_LIMIT_MAX=60
SHOP_API_RATE_LIMIT_WINDOW_MS=60000

# ---- 管理后台 ----
# Admin API 限流（每 IP 每分钟窗口，防止暴力刷接口）
ADMIN_API_RATE_LIMIT_MAX=300
ADMIN_API_RATE_LIMIT_WINDOW_MS=60000

# ---- 其他 ----
# 内部管理鉴权回源地址（多实例/容器环境需要显式指定时使用）
# INTERNAL_ADMIN_AUTH_ORIGIN=http://127.0.0.1:3000